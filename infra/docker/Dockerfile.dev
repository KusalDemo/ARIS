# Builds a tiny Linux image with this Python package installed (used in CI and smoke checks).
FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY pyproject.toml README.md LICENSE ./
COPY aris-rl aris-rl
COPY configs configs

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -e .

# Default command just proves the install worked by printing the package version.
CMD ["python", "-c", "import aris_rl; print(aris_rl.__version__)"]
